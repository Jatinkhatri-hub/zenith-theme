{{ 'header.css' |  asset_url |  stylesheet_tag }}


<header class="nav-bar__container">
  <div class="nav-bar__items">
    <a href="#" class="site-nav__link--icon">
      {%  render 'icon-hamburger' %}
    </a>
    <a href="/">
      <img src="{{ section.settings.desktop_logo |  image_url: width: section.settings.desktop_logo.width }}" class="header__brand-logo">
    </a>
    {% comment %} <a href="{{ routes.cart_url }}" class="site-nav__link site-nav__link--icon js-drawer-open-cart" aria-controls="CartDrawer">
      {%  render 'icon-cart-bag' %} 
    </a> {% endcomment %}
    <a href="{{ routes.cart_url }}" class="site-nav__link site-nav__link--icon js-drawer-open-cart" aria-controls="CartDrawer" data-icon="{{ settings.cart_icon }}">
      {%  render 'icon-cart-bag' %}
    </a>
  </div>
  <div class="nav-drawer__container">
    {% comment %} {% assign navdrawer_menu_started = false %}
    {% assign navdrawer_menu_closed = false %} {% endcomment %}
    <div class="nav-drawer__header">
      <img src="{{ section.settings.desktop_logo |  image_url: width: section.settings.desktop_logo.width }}" class="header__brand-logo">
      <span class="nav-drawer__close-btn">
        {%  render 'icon-cross' %} 
      </span>
    </div>
    {% for block in section.blocks %} 
      {% comment %} {% if block.type == 'menu' and navdrawer_menu_started == false %}
        <div class="nav-menu__wrapper">
          {%  assign navdrawer_menu_started = true %} 
      {% endif %}

      {% if block.type != 'menu' and navdrawer_menu_started == true and navdrawer_menu_closed == false %}

        </div>
        
        {% assign navdrawer_menu_closed = true %}
      {% endif %} {% endcomment %}
      {% case block.type %}
        {% when 'shop_info' %}
          <div class="shop__info-wrapper">
            <h2>{{ block.settings.title }}</h2>
            <div>
              <p><span>{%  render 'icon-feedback' %}</span> {{ block.settings.description_1 }}</p>
              <p><span>{% render 'icon-free-shipping' %}</span> {{ block.settings.description_2 }}</p>
            </div>
          </div> 
        {% when 'product_card' %}
          <a href="{{block.settings.product.url }}" class="nav-drawer__product-card-wrapper">
            <div class="nav__product-card">
              <div class="nav__product-img__wrapper">
                <img src="{{ block.settings.product.featured_image |  image_url: width: block.settings.product.featured_image.width  }}" class="nav__product-img">
              </div>
              <div class="nav__product-info-wrapper">
                <span class="product__badge">{{ block.settings.product_badge }}</span>
                <h2 class="nav__product-title">{{ block.settings.product.title }}</h2>
                <div class="nav__product-review__wrapper">
                  <div class="review-star__wrapper">
                    {%  render 'icon-star' %}
                    {%  render 'icon-star' %}
                    {%  render 'icon-star' %}
                    {%  render 'icon-star' %}
                    {%  render 'icon-star' %}
                  </div>
                  <span>{{ block.settings.review_text }}</span>
                </div>
              </div>
            </div>
            <button class="nav-drawer__product-btn">
              Shop Now
            </button>
          </a>
        {% when 'menu' %}
          <div class="nav-drawer__menu-wrapper">
            <ul class="nav-drawer__parent-menu">
              {% for link in block.settings.nav_menu.links %} 
                <li class="parent_link">
                  <a href="{{ link.url }}">{{ link.title }}</a>
                  <ul class="nav-drawer__child-menu">
                    {% for child in link.links %} 
                      <li class="child_link"><a href="{{ child.url }}"> {{ child.title }}</a> </li>
                    {% endfor %}
                  </ul>
                </li>
              {% endfor %}
            </ul>
          </div>
        {%  when 'logo_social' %}
          <div class="nav-drawer__social-wrapper">
            <p>{{ block.settings.header }}</p>
            {%  render 'social-icons', additional_classes : 'nav-drawer__social-icon' %}
          </div>
      {% endcase %}
    {% endfor %}
    {% comment %} {% if navdrawer_menu_started and navdrawer_menu_closed == false %}
      </div>
    {% endif %} {% endcomment %}
  </div>
</header>

{%  schema  %} 
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_logo",
      "label": "Logo"
    }
  ],
  "blocks": [
    {
      "name": "Shop Info",
      "type": "shop_info",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "default": "Title"
        },
        {
          "type": "inline_richtext",
          "id": "description_1",
          "label": "Description One",
          "default": "Description"
        },
        {
          "type": "inline_richtext",
          "id": "description_2",
          "label": "Description Two",
          "default": "Description"
        }
      ]
    }, 
    {
      "name": "Product",
      "type": "product_card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "product_badge",
          "label": "Product Badge"
        },
        {
          "type": "text",
          "id": "review_text",
          "label": "Review"
        }
      ]
    },
    {
      "name": "Nav Drawer Menu",
      "type": "menu",
      "settings": [
        {
          "type": "link_list",
          "id": "nav_menu",
          "label": "Nav Drawer Menu"
        }
      ]

    },
    {
      "name": "Social",
      "type": "logo_social",
      "settings": [
        {
          "type": "text",
          "id": "header",
          "default": "FOLLOW US ON",
          "label": "Header"
        }

      ]
    }
  ]
}


{% endschema %}