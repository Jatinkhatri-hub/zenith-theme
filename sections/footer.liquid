{{ 'footer.css' |  asset_url |  stylesheet_tag }}

<footer class="section-footer">
  <div class="section-footer__wrapper page-width">
    {% for block in section.blocks %} 
      {% case block.type %} 
        {% when 'brand_info' %}
          <div class="brand__info-wrapper">
            <div class="footer__brand-logo">
              <img src="{{ block.settings.logo_img |  image_url: width: block.settings.logo_img.width }}"  class="footer__brand-img">
            </div>
            <p>{{ block.settings.description }}</p>
            {%  render 'social-icons', additional_classes : 'footer__social-icon' %}
          </div>
        {% when 'menu' %}
          <div class="footer__menu-wrapper">
            {% for link in block.settings.menu.links %} 
              <a href="{{ link.url }}">{{ link.title }}</a>
            {% endfor %}
          </div>
      {% endcase %}
    {% endfor %}
  </div>
  <div class="footer__section">
        {%- render 'multi-selectors',
          locale_selector: locale_selector,
          currency_selector: currency_selector,
          show_currency_flags: section.settings.show_currency_flags
          location: 'footer'
        -%}
  </div>
  <div>
    {%- unless shop.enabled_payment_types == empty -%}
      <ul class="inline-list payment-icons footer__section">
        {%- for type in shop.enabled_payment_types -%}
          <li class="icon--payment">
            {{ type | payment_type_svg_tag }}
          </li>
        {%- endfor -%}
      </ul>
    {%- endunless -%}
  </div>
  <div class="footer__copyright">
    <p>{{ section.settings.copyright }}</p>
  </div>
</footer>

{%  schema  %} 
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright"
    }
  ],
  "blocks": [
    {
      "type": "brand_info",
      "name": "Brand Info",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo_img",
          "label": "Brand Logo"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "limit": 1,
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "Main Menu"
        }
      ]


    }
  ]
}
{% endschema %}